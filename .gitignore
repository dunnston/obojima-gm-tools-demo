# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Logs
*.log
logs/

# Temporary files
temp_*.ts
temp_*.js

# Database files
/data/
*.db
*.db-shm
*.db-wal

# Proprietary content - keep local only
src/data/creatures-full.ts
src/data/creatures-original.ts

# Internal development files - keep local only
*BETA*.md
*CREATURE*.md
*DEMO*.md
*DISTRIBUTION*.md
*INSTALLATION*.md
*Obojima-Potions-Beta*.zip
*PACKAGE*.bat
*SETUP*.bat
*START*.bat
cleanup-*.js
download-*.js
creatures-full-backup.ts
register-*.js
prepare-*.js

# Internal debugging tools
clear-potion-localstorage.html
complete-potion-reset.html
image-registration.txt

# Development scripts folder - keep local only
scripts/
!scripts/prepare-public-release-simple.js

# Audio files - keep folder structure but ignore contents
public/audio/music/*
!public/audio/music/.gitkeep

# Character images - keep folder structure but ignore personal images
public/images/characters/*
!public/images/characters/.gitkeep

# NPC images - keep folder structure but ignore personal images
public/images/npcs/*
!public/images/npcs/.gitkeep

# Tauri build artifacts
src-tauri/target/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm

# Tauri signing keys - NEVER commit these!
*.key
*.key.pub
~/.tauri/
~\.tauri\

# Claude Code local instructions - not needed on GitHub
CLAUDE.md
RELEASE.md

# Local development notes - not needed on GitHub
Tauri conversion*
release_notes*
