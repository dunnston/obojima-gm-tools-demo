{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obojima GM Tools",
  "version": "0.1.0",
  "identifier": "com.obojima.gmtools",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyODgzN0UxRDI3NEU5NjIKUldSaTZYVFM0VGVJUXZ1ZTZnRnhXU1BHQzhpRmtaR2dJV2FMNzh0TDB2RkhRV0FpQ2NxOVBuTkEK",
      "endpoints": [
        "https://github.com/dunnston/obojima-gm-tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/tauri-build.js",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Obojima GM Tools",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
