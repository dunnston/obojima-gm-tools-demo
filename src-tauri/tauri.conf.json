{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obojima GM Tools",
  "version": "0.1.0",
  "identifier": "com.obojima.gmtools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/tauri-build.js",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Obojima GM Tools",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
