{
  "name": "obojima-potions",
  "version": "0.4.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev-network": "next dev --turbopack -H 0.0.0.0",
    "dev:demo": "cross-env NEXT_PUBLIC_DEMO_MODE=true next dev --turbopack -p 3001",
    "build": "next build",
    "build:demo": "npm run prepare-public && cross-env NEXT_PUBLIC_DEMO_MODE=true next build",
    "start": "next start",
    "start:demo": "cross-env NEXT_PUBLIC_DEMO_MODE=true next start -p 3001",
    "lint": "next lint",
    "launch": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && start http://localhost:3000\"",
    "open": "start http://localhost:3000",
    "backup-creatures": "node scripts/simple-backup.js",
    "prepare-public": "node scripts/prepare-public-release-simple.js",
    "restore-full-creatures": "node scripts/restore-full-creatures.js",
    "build-public": "npm run prepare-public && npm run build",
    "tauri": "tauri",
    "tauri:dev": "cross-env TAURI_BUILD=true tauri dev",
    "tauri:build": "cross-env TAURI_BUILD=true tauri build",
    "version:sync": "node scripts/sync-versions.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.2.0",
    "csv-parser": "^3.2.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "next": "15.4.10",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.0.0",
    "csv-parse": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
